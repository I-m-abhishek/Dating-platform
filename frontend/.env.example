# Copy to .env.local for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# Testing calls on a phone: iOS only allows the microphone/camera on HTTPS pages.
# Leave both URLs EMPTY so the browser talks to the Next server, which proxies /api and /ws
# to BACKEND_URL. Then run `npm run dev:https` (or put a cloudflared/ngrok tunnel in front of
# `npm run dev`) and open the https:// address on the phone.
# NEXT_PUBLIC_API_BASE_URL=
# NEXT_PUBLIC_WS_URL=
# BACKEND_URL=http://localhost:8080
